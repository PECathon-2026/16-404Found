# Copy to backend/.env — placeholders only, never commit real keys.
DEVPILOT_DATA_DIR=./data
# LLM providers (any one). Without a key, only scripted (demo/test) missions can run.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
# Optional GitHub token: clone private repos, and push a branch / open a PR after approval.
GITHUB_TOKEN=
# Frontend origin allowed by CORS
DEVPILOT_CORS_ORIGINS=http://localhost:3000
